         RowBox[{"g", "=", "1.`"}]}], ",", 
        RowBox[{"l", "<", "645.`"}], ",", 
        RowBox[{
         RowBox[{"r", "=", "1.`"}], ";", 
         RowBox[{"g", "=", 
          FractionBox[
           RowBox[{"645.`", "\[VeryThinSpace]", "-", "l"}], "65.`"]}]}], ",", 
        "True", ",", 
        RowBox[{"r", "=", "1.`"}]}], "]"}], ";", 
      RowBox[{"f", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"l", "<", "420.`"}], ",", 
         RowBox[{"0.3`", "\[VeryThinSpace]", "+", 
          FractionBox[
           RowBox[{"0.7`", " ", 
            RowBox[{"(", 
             RowBox[{"l", "-", "380.`"}], ")"}]}], "40.`"]}], ",", 
         RowBox[{"l", ">", "700.`"}], ",", 
         RowBox[{"0.3`", "\[VeryThinSpace]", "+", 
          FractionBox[
           RowBox[{"0.7`", " ", 
            RowBox[{"(", 
             RowBox[{"780.`", "\[VeryThinSpace]", "-", "l"}], ")"}]}], 
           "80.`"]}], ",", "True", ",", "1.`"}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Clip", "[", 
          RowBox[{"#1", ",", 
           RowBox[{"{", 
            RowBox[{"0.`", ",", "1.`"}], "}"}]}], "]"}], "&"}], ")"}], "/@", 

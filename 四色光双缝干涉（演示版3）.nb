Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"wl2rgb", "[", "l0_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"Clip", "[", 
         RowBox[{
          RowBox[{"N", "[", "l0", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"380.`", ",", "780.`"}], "}"}]}], "]"}]}], ",", 

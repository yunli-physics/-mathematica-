         RowBox[{"r", "=", 
          FractionBox[
           RowBox[{"440.`", "\[VeryThinSpace]", "-", "l"}], "60.`"]}], ";", 
         RowBox[{"b", "=", "1.`"}]}], ",", 
        RowBox[{"l", "<", "490.`"}], ",", 

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chip", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lam_", ",", "rgb_", ",", "lab_"}], "}"}], ",", "d0_", ",", 
     "L_", ",", "xP_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "f", ",", "txt", ",", "col"}], "}"}], ",", 
     RowBox[{
      RowBox[{"m", "=", 
       FractionBox[
        RowBox[{"drOf", "[", 
         RowBox[{"d0", ",", "L", ",", "xP"}], "]"}], 
        FractionBox["lam", 
         SuperscriptBox["10", "9"]]]}], ";", 
      RowBox[{"f", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"m", "-", 
         RowBox[{"Round", "[", "m", "]"}]}], "]"}]}], ";", 
      RowBox[{"txt", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"f", "<", "0.18`"}], ",", "\"\<\:660e\:7eb9\>\"", ",", 
         RowBox[{"f", ">", "0.32`"}], ",", "\"\<\:6697\:7eb9\>\"", ",", 
         "True", ",", "\"\<\:8fc7\:6e21\>\""}], "]"}]}], ";", 
      RowBox[{"col", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"f", "<", "0.18`"}], ",", 
         RowBox[{"RGBColor", "@@", "rgb"}], ",", 
         RowBox[{"f", ">", "0.32`"}], ",", 
         TemplateBox[<|"color" -> GrayLevel[0.45]|>,
          "GrayLevelColorSwatchTemplate"], ",", "True", ",", 
         TemplateBox[<|"color" -> RGBColor[0.6, 0.45, 0.05]|>,
          "RGBColorSwatchTemplate"]}], "]"}]}], ";", 
      FrameBox[
       TemplateBox[{
         RowBox[{"Style", "[", 
           RowBox[{"\"\[FilledCircle]\"", ",", "10", ",", 
             RowBox[{"RGBColor", "@@", "rgb"}]}], "]"}], 
         StyleBox[
          RowBox[{"\" \"", "<>", "lab"}], 10.5, 
          GrayLevel[0.2], StripOnInput -> False], 
         StyleBox[
          RowBox[{"\"  \"", "<>", 
            RowBox[{"ToString", "[", 
              TagBox["m", NumberForm[#, {3, 2}]& ], "]"}], "<>", 
            "\"\[Lambda]\""}], 10.5, 
          GrayLevel[0.45], StripOnInput -> False], 
         RowBox[{"Style", "[", 
           RowBox[{
             RowBox[{"\"  \"", "<>", "txt"}], ",", "10.5`", ",", "Bold", ",", 
             "col"}], "]"}]},
        "RowDefault"],
       Background->GrayLevel[0.985],
       FrameMargins->{{7, 7}, {2, 3}},
       FrameStyle->GrayLevel[0.88],
       RoundingRadius->5,
       StripOnInput->False]}]}], "]"}]}], ";"}]], "Input",

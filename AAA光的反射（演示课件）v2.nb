       "th2", ",", "R", ",", "fig", ",", "statGrid", ",", "note", ",", "rs", ",",
        "rp"}], "}"}], ",", 
     RowBox[{
      RowBox[{"C", "=", 
       RowBox[{"ArcSin", "[", 
        RowBox[{"1", "/", "n1"}], "]"}]}], ";", 
      RowBox[{"s2", "=", 
       RowBox[{"n1", 
        RowBox[{"Sin", "[", "t", "]"}]}]}], ";", 
      RowBox[{"tot", "=", 
       RowBox[{"s2", ">", "1."}]}], ";", 
      RowBox[{"th2", "=", 
       RowBox[{"If", "[", 
        RowBox[{"tot", ",", "0.", ",", 
         RowBox[{"ArcSin", "[", 
          RowBox[{"Min", "[", 
           RowBox[{"s2", ",", "1."}], "]"}], "]"}]}], "]"}]}], ";", 

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chip", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lam_", ",", "rgb_", ",", "lab_"}], "}"}], ",", "d0_", ",", 
     "L_", ",", "xP_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "f", ",", "txt", ",", "col"}], "}"}], ",", 
     RowBox[{

                RowBox[{"k", ",", "1"}], "\[RightDoubleBracket]"}], ",", "d0",
                ",", "L"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", "chans", "]"}]}], "}"}]}], "]"}], 
          "]"}]}], "]"}]}], ";", 

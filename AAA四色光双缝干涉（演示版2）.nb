         RowBox[{"g", "=", 
          FractionBox[
           RowBox[{"l", "-", "440.`"}], "50.`"]}], ";", 
         RowBox[{"b", "=", "1.`"}]}], ",", 
        RowBox[{"l", "<", "510.`"}], ",", 
        RowBox[{
         RowBox[{"g", "=", "1.`"}], ";", 
         RowBox[{"b", "=", 
          FractionBox[
           RowBox[{"510.`", "\[VeryThinSpace]", "-", "l"}], "20.`"]}]}], ",", 
        RowBox[{"l", "<", "580.`"}], ",", 
        RowBox[{
         RowBox[{"r", "=", 

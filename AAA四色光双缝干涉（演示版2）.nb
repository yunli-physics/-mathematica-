         RowBox[{"f", "<", "0.18`"}], ",", 
         RowBox[{"RGBColor", "@@", "rgb"}], ",", 
         RowBox[{"f", ">", "0.32`"}], ",", 
         TemplateBox[<|"color" -> GrayLevel[0.45]|>,
          "GrayLevelColorSwatchTemplate"], ",", "True", ",", 
         TemplateBox[<|"color" -> RGBColor[0.6, 0.45, 0.05]|>,
          "RGBColorSwatchTemplate"]}], "]"}]}], ";", 
      FrameBox[
       TemplateBox[{
         RowBox[{"Style", "[", 
           RowBox[{"\"\[FilledCircle]\"", ",", "10", ",", 
             RowBox[{"RGBColor", "@@", "rgb"}]}], "]"}], 
         StyleBox[
          RowBox[{"\" \"", "<>", "lab"}], 10.5, 
          GrayLevel[0.2], StripOnInput -> False], 
         StyleBox[
          RowBox[{"\"  \"", "<>", 
            RowBox[{"ToString", "[", 
              TagBox["m", NumberForm[#, {3, 2}]& ], "]"}], "<>", 
            "\"\[Lambda]\""}], 10.5, 
          GrayLevel[0.45], StripOnInput -> False], 
         RowBox[{"Style", "[", 

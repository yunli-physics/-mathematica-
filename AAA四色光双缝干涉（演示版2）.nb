         RowBox[{"g", "=", "1.`"}]}], ",", 
        RowBox[{"l", "<", "645.`"}], ",", 
        RowBox[{
         RowBox[{"r", "=", "1.`"}], ";", 
         RowBox[{"g", "=", 

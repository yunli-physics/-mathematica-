       FractionBox[
        RowBox[{"drOf", "[", 
         RowBox[{"d0", ",", "L", ",", "xP"}], "]"}], 
        FractionBox["lam", 
         SuperscriptBox["10", "9"]]]}], ";", 
      RowBox[{"f", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"m", "-", 
         RowBox[{"Round", "[", "m", "]"}]}], "]"}]}], ";", 
      RowBox[{"txt", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"f", "<", "0.18`"}], ",", "\"\<\:660e\:7eb9\>\"", ",", 
         RowBox[{"f", ">", "0.32`"}], ",", "\"\<\:6697\:7eb9\>\"", ",", 
         "True", ",", "\"\<\:8fc7\:6e21\>\""}], "]"}]}], ";", 
